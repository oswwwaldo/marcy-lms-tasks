{
  "name": "Marcy LMS Tasks",
  "description": "Sync your Google Tasks workflow automatically with incoming assignments from Marcy LMS",
  "version": "1.0.0",
  "key": "",
  "manifest_version": 3,
  "oauth2": {
    "client_id": "869270636017-hndo6m3l3tfrgbdikr02u6kqodmab5cd.apps.googleusercontent.com",
    
    "scopes": [
      "https://www.googleapis.com/auth/tasks"
    ]
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png", 
    "128": "images/icon-128.png"
  },
  "action": {
    "default_popup": "marcy-lms-tasks.html",
    "default_icon": "images/icon-16.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://mls-lms.vercel.app/;"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "*://mls-lms.vercel.app/*"
  ],
  "permissions": [
    "alarms", 
    "identity",
    "notifications",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["*://mls-lms.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}